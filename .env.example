# Demonstrative configuration only. Use a secret manager; never commit real values.
INFINITEPAY_CHECKOUT_ENABLED=false
INFINITEPAY_MODE=disabled
# Production preparation only: flags never replace an explicit application authorizer.
INFINITEPAY_WORKER_ENABLED=false
INFINITEPAY_VERIFY_ENABLED=false
INFINITEPAY_DELIVERY_ENABLED=false
INFINITEPAY_DATABASE_NAME=
INFINITEPAY_DATABASE_ID=
INFINITEPAY_PUBLIC_ORIGIN=
INFINITEPAY_SUCCESS_URL=
INFINITEPAY_ALLOWED_PUBLIC_ORIGINS=
INFINITEPAY_TRUSTED_PROXY_IPS=
# Optional private CA supplied by the secret manager for a remote PostgreSQL.
DB_SSL_CA=
# Generate a fresh random 32-byte base64 key outside Git:
INFINITEPAY_ENCRYPTION_KEY=
INFINITEPAY_ENCRYPTION_KEY_VERSION=1
# Optional versioned key ring, e.g. JSON mapping version to a base64 key; no real example keys.
INFINITEPAY_ENCRYPTION_KEYS=
ALLOWED_ORIGINS=http://localhost:3000
# No production connection belongs in test configuration.
TEST_DATABASE_URL=postgresql://codex_test@127.0.0.1:55439/infinitepay_phase1_test
