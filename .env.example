# Template without secrets. See docs/INFINITEPAY-RENDER-NEON.md.
# Never commit .env files or actual production connection strings.
NODE_ENV=development
INFINITEPAY_MODE=disabled
INFINITEPAY_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000

# Render + Neon production: set these in the Render Environment panel.
# DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
# FRONTEND_URL=https://your-frontend.example.com
# JWT_SECRET=<random-secret-at-least-32-characters>
# INFINITEPAY_DATABASE_ID=<existing-production-database-uuid>
# INFINITEPAY_ENCRYPTION_KEY=<32-random-bytes-base64>
# INFINITEPAY_ENCRYPTION_KEY_VERSION=1
# INFINITEPAY_MODE=production
# INFINITEPAY_ENABLED=false

# Optional: override when using custom domains or more than one frontend.
# BACKEND_URL=https://api.example.com
# INFINITEPAY_PUBLIC_ORIGIN=https://api.example.com
# INFINITEPAY_SUCCESS_URL=https://orders.example.com/pedido/sucesso
# INFINITEPAY_ALLOWED_PUBLIC_ORIGINS=https://api.example.com,https://orders.example.com
# ALLOWED_ORIGINS=https://orders.example.com
# DB_SSL_CA=

# Advanced safety controls: explicit false wins over the master enable flag.
# INFINITEPAY_CHECKOUT_ENABLED=false
# INFINITEPAY_WORKER_ENABLED=false
# INFINITEPAY_VERIFY_ENABLED=false
# INFINITEPAY_DELIVERY_ENABLED=false

# Non-Render deployments require explicit trusted reverse proxy IPs.
# INFINITEPAY_TRUSTED_PROXY_IPS=192.0.2.10

# Local tests use a separate loopback-only database.
TEST_DATABASE_URL=postgresql://codex_test@127.0.0.1:55439/infinitepay_phase1_test
