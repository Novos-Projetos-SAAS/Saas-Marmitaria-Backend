meta {
  name: 04 - PUT com CSRF invalido (403)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/configuracoes/infinitepay
  body: json
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
  Content-Type: application/json
  Origin: {{allowedOrigin}}
  X-Infinitepay-CSRF: bruno-csrf-invalido
}

body:json {
  {
    "ativo": false
  }
}

tests {
  test("HTTP 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
