meta {
  name: 01 - Login de teste (200)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "senha": "{{loginSenha}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const header = res.getHeader("set-cookie");
    const raw = Array.isArray(header) ? header.join("; ") : String(header || "");
    const match = raw.match(/(?:^|[,\s])token=([^;,\s]+)/);
    if (match) bru.setVar("sessionCookie", "token=" + match[1]);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Cookie token foi recebido e guardado apenas em memória", function () {
    expect(bru.getVar("sessionCookie")).to.match(/^token=\S+$/);
  });
  test("Login autenticado", function () {
    expect(res.getBody().status).to.equal("success");
  });
}
