meta {
  name: 06 - Recusar parcelas invalidas (400)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/configuracoes/infinitepay
  body: json
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
  Content-Type: application/json
  Origin: {{allowedOrigin}}
  X-Infinitepay-CSRF: {{csrfToken}}
}

body:json {
  {
    "assured_installments": 13
  }
}

tests {
  test("HTTP 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
