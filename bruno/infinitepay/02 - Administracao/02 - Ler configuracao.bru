meta {
  name: 02 - Ler configuracao (200)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/configuracoes/infinitepay
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

script:post-response {
  const b = res.getBody() || {};
  if (res.getStatus() === 200 && typeof b.csrf_token === "string") bru.setVar("csrfToken", b.csrf_token);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Integração segue desativada", function () {
    const b = res.getBody(); expect(b.data.ativo).to.equal(false); expect(b.data.has_api_key).to.be.a("boolean");
  });
  test("Resposta não revela chave", function () {
    const b = res.getBody(); expect(b.data).not.to.have.property("api_key"); expect(b.data).not.to.have.property("credencial_atual_id");
  });
  test("CSRF e cache privados", function () {
    expect(bru.getVar("csrfToken")).to.match(/^[A-Za-z0-9_-]{43}$/); expect(String(res.getHeader("cache-control"))).to.include("no-store");
  });
}
